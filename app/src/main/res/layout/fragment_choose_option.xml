<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chooseOption"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/house_backg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20.dp"
        android:paddingEnd="20.dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/showSpellGuideBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_btn"
            android:text="Show Spells Guide"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20.sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40.dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/showCharactersBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_btn"
            android:text="Show Characters"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20.sp" />

    </LinearLayout>

</FrameLayout>